@startuml
title Antrag auf Nachteilsausgleich annehmen oder ablehnen

!theme plain
skinparam linetype ortho
start

:<back:White>"/service/compensation-for-disadvantages-requests" öffnen;
:<back:LightBlue>Tabelle "Offene Anträge" durchsuchen;
:<back:LightBlue>Eintrag anklicken -> Detailmodal erscheint;
:<back:LightGreen>Daten und Ausweisfotos prüfen;
if (Antrag korrekt?) then (ja)
  :<back:LightGreen>"Annehmen" klicken;
else (nein)
  :<back:LightPink>"Ablehnen" klicken;
endif
:<back:White>Liste aktualisiert sich;

stop
@enduml
