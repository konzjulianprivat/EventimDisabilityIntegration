@startuml
title Tour löschen

!theme plain
skinparam linetype ortho
start

:<back:White>"/admin/tours" aufrufen;
:<back:LightBlue>Bei einer Tour auf "Löschen" klicken;
if (keine verkauften Tickets?) then (ja)
  :<back:LightGreen>Bestätigungsdialog -> "Ja, löschen";
  :<back:LightGreen>Tour wird entfernt und Liste neu geladen;
else (nein)
  :<back:LightCoral>Hinweis "Löschen nicht möglich" anzeigen;
endif

stop
@enduml
