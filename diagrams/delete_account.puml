@startuml
title Konto löschen

!theme plain
skinparam linetype ortho
start

:<back:White>"/profile" öffnen;
:<back:LightBlue>"Account löschen" wählen;
:<back:LightGreen>Dialog verlangt Eingabe "Löschen";
if (noch offene Tickets?) then (ja)
  :<back:LightCoral>Fehlermeldung anzeigen;
else (nein)
  :<back:LightGreen>Eingabe bestätigen -> Konto wird entfernt;
  :<back:LightCoral>Lokale Sessiondaten entfernen;
  :<back:White>Weiterleitung zur Startseite;
endif

stop
@enduml
